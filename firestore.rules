rules_version = '2';

// El catálogo se lee directo desde el navegador para tener cupos en vivo
// (onSnapshot). Toda escritura pasa por la API con el Admin SDK, que se salta
// estas reglas — por eso aquí todo lo demás queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /centros/{centroId} {
      allow read: if true;
      allow write: if false;
    }

    match /turnos/{turnoId} {
      allow read: if true;
      allow write: if false;

      // Un voluntario no puede enumerar quién más se inscribió.
      match /inscritos/{hash} {
        allow read, write: if false;
      }
    }

    match /catalogos/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // El semáforo de donaciones también se lee en vivo desde el navegador.
    // El admin lo cambia por la API (Admin SDK), no desde el cliente.
    match /catalogoDonaciones/{elementoId} {
      allow read: if true;
      allow write: if false;
    }

    match /necesidades/{necesidadId} {
      allow read: if true;
      allow write: if false;
    }

    // Datos personales: nunca desde el cliente.
    match /reservas/{reservaId} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// El catálogo se lee directo desde el navegador para tener cupos en vivo
// (onSnapshot). Toda escritura pasa por la API con el Admin SDK, que se salta
// estas reglas — por eso aquí todo lo demás queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /centros/{centroId} {
      allow read: if true;
      allow write: if false;
    }

    match /turnos/{turnoId} {
      allow read: if true;
      allow write: if false;

      // Un voluntario no puede enumerar quién más se inscribió.
      match /inscritos/{hash} {
        allow read, write: if false;
      }
    }

    match /catalogos/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // El semáforo de donaciones también se lee en vivo desde el navegador.
    // El admin lo cambia por la API (Admin SDK), no desde el cliente.
    match /catalogoDonaciones/{elementoId} {
      allow read: if true;
      allow write: if false;
    }

    match /necesidades/{necesidadId} {
      allow read: if true;
      allow write: if false;
    }

    // Bancos de sangre: el navegador se suscribe con onSnapshot para que un
    // cambio en la hoja se vea al instante. Lo que se lee acá es dónde queda un
    // banco y qué recibe hoy — información pública por definición.
    //
    // El tipo de sangre del donante NO viaja: el filtro corre en el navegador
    // contra esta lista. Es dato sensible de salud y no tiene por qué salir del
    // dispositivo, ni siquiera como parámetro de una consulta.
    match /bancosSangre/{bancoId} {
      allow read: if true;
      allow write: if false;
    }

    // Datos personales: nunca desde el cliente.
    match /reservas/{reservaId} {
      allow read, write: if false;
    }

    // Cuentas del panel y sesiones abiertas. Cerradas por completo: aquí viven
    // los digests de las contraseñas de los coordinadores y los de las sesiones
    // en curso, y ninguna pantalla los necesita — el login pasa por la API con
    // el Admin SDK, que se salta estas reglas.
    match /usuarios/{usuarioId} {
      allow read, write: if false;
    }

    match /sesiones/{sesionId} {
      allow read, write: if false;
    }
  }
}

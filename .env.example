# Copia este archivo a `.env.local` y completa los valores.
# Las variables se declaran y validan en `src/server/config/env.ts`.

# Nivel mínimo de log: debug | info | warn | error
LOG_LEVEL=debug

# URL pública de la app (se expone al navegador)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (descomenta también el campo en src/server/config/env.ts)
# DATABASE_URL=

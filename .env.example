# Copia este archivo a `.env.local` y completa los valores.
# Las variables se declaran y validan en `src/server/config/env.ts`.

# Nivel mínimo de log: debug | info | warn | error
LOG_LEVEL=debug

# Dónde viven los datos: firestore | memory  (por defecto firestore)
#
# `memory` levanta la app completa sin credenciales de ningún tipo: útil para
# una demo o para trabajar antes de tener acceso al proyecto de Firebase.
# Implementa la misma concurrencia optimista que Firestore, así que las reservas
# tampoco pueden sobrevender. Lo que no hace es persistir: se pierde todo al
# reiniciar, y con más de una instancia cada una tendría sus propios datos.
DB_DRIVER=firestore

# URL pública de la app (se expone al navegador)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase / Firestore -----------------------------------------------
# FIREBASE_PROJECT_ID es obligatorio en producción. `volbogota` es el proyecto que
# sirve el deploy de App Hosting, y es también el que consume el entorno local: se
# trabaja contra los datos de verdad.
#
# OJO: local escribe en la misma base que el evento. Una inscripción de prueba
# queda guardada en producción. Para no tocarla, `DB_DRIVER=memory` o el emulador.
#
# La autenticación contra Firestore, en cambio, se resuelve por el primer camino
# que encuentre configurado — no hace falta llenar los tres:
#
#   1) Clave de cuenta de servicio (abajo). No siempre es una opción: una
#      organización puede bloquear su creación con
#      constraints/iam.disableServiceAccountKeyCreation, como pasa aquí con
#      cifrato.co. Si no tienes el JSON, sigue con el punto 2 o 3.
#   2) Workload Identity Federation (ver sección siguiente) — el camino en
#      Vercel, sin ninguna clave.
#   3) Application Default Credentials — el camino en desarrollo local:
#        gcloud auth application-default login
#        gcloud auth application-default set-quota-project volbogota
#      o el que usa cualquier runtime de Google (Cloud Run, App Hosting),
#      donde la identidad va adjunta al servicio. En App Hosting es este: la
#      cuenta va adjunta al servicio y no hay ninguna llave que poner.
FIREBASE_PROJECT_ID=volbogota

# Solo si usas el camino 1. Firebase Console → Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada.
# Van las dos o ninguna: con una sola la app no arranca.
FIREBASE_CLIENT_EMAIL=
# La clave va entre comillas y con los \n escapados, tal cual sale del JSON.
FIREBASE_PRIVATE_KEY=""

# --- Workload Identity Federation (autenticación en Vercel, sin clave) --
# Van las cuatro o ninguna. No se usan en local: getVercelOidcToken() solo
# resuelve dentro del runtime de Vercel. En local usa el camino 3 de arriba.
# Ver detalle y comandos de creación en el pool `vercel-backend` del proyecto
# GCP centros-de-acopio-5e6a1.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# --- Seguridad ----------------------------------------------------------
# Secreto para el digest de deduplicación por turno del celular.
# Sin él, el hash sería reversible: un celular colombiano vive en un espacio
# de ~3e9 valores y el diccionario completo se precomputa en minutos.
# Genera uno con:  openssl rand -base64 48
# OJO: no se puede rotar una vez existan inscripciones reales — invalidaría
# todos los digests guardados y rompería la deduplicación por turno.
CELULAR_HASH_SALT=

# Token compartido de los endpoints /api/admin. Sin él, los datos personales de
# los voluntarios quedarían accesibles a cualquiera.
# Genera uno con:  openssl rand -base64 48
ADMIN_API_TOKEN=

# Token que presenta el Apps Script de la hoja maestra al llamar
# /api/hooks/sheets/*. Esos endpoints escriben el catálogo y crean reservas,
# así que es lo único que los separa de cualquiera que descubra la URL.
# Va aparte del de admin: la hoja se comparte con más gente que el panel, y así
# revocarle el acceso a una no toca a la otra.
# Genera uno con:  openssl rand -base64 48
SHEETS_HOOK_TOKEN=

# URL del despliegue "Web app" del Apps Script de la hoja. Es la dirección
# contraria de la sincronización: por acá el backend empuja las reservas hacia
# la hoja, para que un voluntario que se inscribe en la web aparezca en la lista
# que leen los coordinadores en la portería.
#
# Al desplegar el script: "Ejecutar como: Yo" y "Quién tiene acceso: Cualquiera".
# El backend llama sin sesión de Google; quien autoriza es SHEETS_HOOK_TOKEN,
# que el script valida en el cuerpo de la petición.
#
# Sin esta variable el empuje se omite en silencio, que es lo correcto mientras
# el script no esté desplegado.
SHEETS_WEBHOOK_URL=

# Id de la hoja maestra: el trozo de su URL entre /d/ y /edit.
#
# El empuje desde la hoja solo ocurre cuando alguien la edita, así que un
# backend recién arrancado —un despliegue nuevo, o cualquier reinicio con
# DB_DRIVER=memory— se quedaría vacío hasta que un humano toque una celda. Con
# este id, las rutas de lectura leen el CSV publicado de la hoja y responden con
# datos reales. No necesita credenciales: basta con que el archivo esté
# compartido por enlace.
SHEET_ID=

# --- Firebase, configuración del cliente web ----------------------------
# PÚBLICA por diseño: viaja dentro del bundle del navegador de cualquier
# visitante, así que no es un secreto y por eso sí va en este archivo.
# Quien controla el acceso son las reglas de `firestore.rules`, no estas claves.
# La necesita el front para suscribirse a los cupos en vivo con onSnapshot.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA7WTKybRS80O6NdSOMSKtTDGVwyz5t7YA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=volbogota.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=volbogota
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=volbogota.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=761468343345
NEXT_PUBLIC_FIREBASE_APP_ID=1:761468343345:web:f2b1f908f0e39b9705b110

# --- Flags de features (cliente) ----------------------------------------
# Habilita la selección de elementos para donar + la canasta de confirmación
# en /donar. Por defecto `false`: la página queda solo informativa (muestra qué
# necesita cada centro, sin checkboxes ni botón de donar). Ponla en `true` para
# activar el flujo interactivo. Se incrusta en el bundle (build).
NEXT_PUBLIC_DONAR_SELECCION=false
